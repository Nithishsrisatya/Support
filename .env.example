# ==============================================================================
# COMPLIFY SUPPORT - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual production values.
# DO NOT commit the .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments, or 'development' for local development.
NODE_ENV=production

# The port on which the Express server listens (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (e.g. for managed cloud databases like RDS, Supabase, Neon)
# DATABASE_URL=postgresql://dbuser:dbpassword@dbhost:5432/dbname?sslmode=require

# Option B: Granular Connection Variables
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=complify
DB_USER=complify_user
DB_PASSWORD=your_secure_db_password_here

# Enable SSL for managed cloud PostgreSQL (set to true for cloud providers, false for local)
DB_SSL=false

# PostgreSQL Connection Pool Options
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# High-entropy random secret key (min 32 characters) for signing JWT access tokens.
# Generate via: openssl rand -base64 32
JWT_SECRET=your_long_random_high_entropy_jwt_secret_key_here

# Initial Administrator password used during database initialization on a fresh database.
INITIAL_ADMIN_PASSWORD=your_secure_initial_admin_password_here

# ------------------------------------------------------------------------------
# 4. FRONTEND DOMAIN & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Public canonical HTTPS URL of the application (used in emails and links)
FRONTEND_URL=https://support.yourcompany.com

# Allowed CORS Origin(s). Multiple origins can be comma-separated.
CORS_ORIGIN=https://support.yourcompany.com

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# Outgoing SMTP mail server settings for operational notifications and password resets.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@support.yourcompany.com
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=Complify Support <noreply@support.yourcompany.com>

# ------------------------------------------------------------------------------
# 6. PERSISTENT FILE STORAGE
# ------------------------------------------------------------------------------
# Absolute path on the server for persisting uploaded ticket and task attachments.
# Must be outside temporary build output and persistent across deployments.
UPLOAD_DIR=/var/www/complify/uploads/tickets

# ------------------------------------------------------------------------------
# 7. RATE LIMITING (OPTIONAL OVERRIDES)
# ------------------------------------------------------------------------------
# Max authentication requests per 15 minutes per IP (default: 15)
AUTH_RATE_LIMIT_MAX=15

# Max attachment upload requests per 15 minutes per IP (default: 50)
UPLOAD_RATE_LIMIT_MAX=50

# Max general API requests per 15 minutes per IP (default: 500)
API_RATE_LIMIT_MAX=500